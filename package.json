  ],
  "author": "Huang Tianhui <huangtianhui@xiaobangtouzi.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeant/iwencai-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
